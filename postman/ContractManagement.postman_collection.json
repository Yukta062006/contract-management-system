				{
					"name": "1.1 Upload Contract (PDF)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 201 Created\", function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"",
									"pm.test(\"Contract response has ID, status DRAFT, and extracted text\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.id).to.be.a('number');",
									"    pm.expect(jsonData.status).to.eql('DRAFT');",
									"    pm.expect(jsonData.extractedText).to.be.a('string');",
									"    pm.expect(jsonData).to.have.property('contractDescription');",
									"    ",
									"    // Automatically save contractId into collection variable",
									"    pm.collectionVariables.set(\"contractId\", jsonData.id);",
									"    console.log(\"Saved contractId: \" + jsonData.id);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "formdata",
							"formdata": [
								{
									"key": "file",
									"type": "file",
									"src": "samples/sample_employment_agreement.pdf",
									"description": "Select samples/sample_employment_agreement.pdf or sample_employment_agreement.docx"
								},
								{
									"key": "description",
									"value": "Employment agreement for Rahul Sharma covering 30-day notice period and Rs. 50,000 monthly CTC in Pune",
									"type": "text",
									"description": "Meaningful contract description"
								}
							]
						},
						"url": {
							"raw": "{{baseUrl}}/api/contracts",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"contracts"
							]
						},
						"description": "Uploads a new PDF contract. Initial status becomes DRAFT."
					},
					"response": []
				},
				{
